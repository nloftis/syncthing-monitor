# Syncthing
ST_URL=http://127.0.0.1:8384
ST_API_KEY=replace-with-syncthing-api-key

# Monitored folders
# Format: folder-id:display-name[,folder-id:display-name...]
FOLDERS=folder-id-1:documents,folder-id-2:photos

# Receive Only monitoring
STATUS_INTERVAL=900
RESTART_CHECK_INTERVAL=60

# Remote mass-deletion detection
REMOTE_DELETE_THRESHOLD=50
REMOTE_DELETE_WINDOW=300
MAX_PATHS=20

# Notifications
NOTIFY_METHOD=email
NOTIFY_RETRY_INTERVAL=60

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-app-password
MAIL_FROM=replace-with-sender-address
MAIL_TO=replace-with-recipient-address
